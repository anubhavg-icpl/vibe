{
  "name": "vibe-modes",
  "version": "2.0.0",
  "description": "Single-command installer for the Vibe AI-agent asset library — skills, agents, commands, and modes across 7 coding-agent CLIs.",
  "author": "Anubhav Gain <anubhavg@infopercept.com>",
  "license": "CC-BY-NC-SA-4.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/anubhavg-icpl/vibe"
  },
  "homepage": "https://github.com/anubhavg-icpl/vibe",
  "bugs": {
    "url": "https://github.com/anubhavg-icpl/vibe/issues"
  },
  "keywords": [
    "ai",
    "coding-assistant",
    "prompts",
    "development",
    "modes",
    "skills",
    "agents",
    "claude-code",
    "cursor",
    "codex",
    "opencode",
    "gemini-cli",
    "copilot-cli",
    "factory-droid",
    "agent-skills"
  ],
  "scripts": {
    "lint": "markdownlint-cli2 'modes/**/*.md' '*.md'",
    "lint:fix": "markdownlint-cli2 --fix 'modes/**/*.md' '*.md'",
    "format": "prettier --write 'modes/**/*.md' '*.md'",
    "format:check": "prettier --check 'modes/**/*.md' '*.md'",
    "check": "pnpm run lint && pnpm run format:check",
    "fix": "pnpm run lint:fix && pnpm run format",
    "generate:index": "python scripts/generate-modes-index.py",
    "fix:diagrams": "python scripts/fix-diagrams.py",
    "build": "tsup src/index.ts --format esm --dts --clean --target node18",
    "dev": "tsx src/index.ts",
    "prepare": "node -e \"const fs=require('fs');if(!fs.existsSync('dist/index.js')&&fs.existsSync('src/index.ts')){try{require('child_process').execSync('npm run build',{stdio:'inherit'})}catch(e){console.warn('vibe: build skipped (dev tools missing)')}}\"",
    "prepublishOnly": "pnpm run build"
  },
  "type": "module",
  "bin": {
    "vibe": "./dist/index.js"
  },
  "files": [
    "dist",
    "skills",
    "agents",
    "commands",
    "modes",
    "rules",
    "prompts",
    "README.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@types/node": "^22.10.0",
    "markdownlint-cli2": "^0.14.0",
    "prettier": "^3.3.3",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@clack/prompts": "^0.9.1",
    "boxen": "^8.0.1",
    "chalk": "^5.4.1",
    "cli-table3": "^0.6.5",
    "commander": "^13.1.0",
    "figures": "^6.1.0",
    "fuse.js": "^7.1.0",
    "gray-matter": "^4.0.3",
    "yaml": "^2.6.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "pnpm@9.1.0"
}
